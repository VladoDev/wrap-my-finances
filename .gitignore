#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase per-flavor platform config — client identifiers extractable from any shipped binary,
# gitignored to keep flavor wiring unambiguous, not for secrecy (see docs/ENVIRONMENTS.md §7).
# firebase_options_*.dart IS committed — it holds no secrets.
android/app/src/dev/google-services.json
android/app/src/prod/google-services.json
ios/flavors/dev/GoogleService-Info.plist
ios/flavors/prod/GoogleService-Info.plist

# Signing keys and provisioning — real secrets, never committed
*.keystore
*.jks
*.p12
*.mobileprovision

# Firebase CLI local state and emulator logs
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log

# Node (Security Rules test project)
node_modules/
